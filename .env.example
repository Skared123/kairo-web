# Copy this file to .env.local and adjust the values. .env.local is never committed.

# Where the Kairo API listens. Server Components call it directly; the browser goes through /api (decision 018).
# The /api rewrites are fixed at build time: after changing it, run `pnpm build` again. `pnpm dev` reads it at start.
API_URL=http://localhost:4000
